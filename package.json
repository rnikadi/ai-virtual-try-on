{
  "name": "ai-virtual-try-on",
  "private": true,
  "description": "Virtual try-on POC for e-commerce, powered by the Gemini API",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "db:reset": "npm run reset --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tryon": "npm run tryon --workspace backend --",
    "catalog:images": "npm run catalog:images --workspace backend --"
  }
}
