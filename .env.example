# Backend
DATABASE_URL=postgres://tryon:tryon@localhost:5432/tryon
PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Where Gemini runs:
#   gemini-api  key from https://aistudio.google.com/apikey
#   vertex      Vertex AI API key from Google Cloud console (APIs & Services > Credentials), billed to your project
GEMINI_PROVIDER=gemini-api
GEMINI_API_KEY=
# Optional: route Gemini calls through a proxy or test stub
# GEMINI_BASE_URL=
# Model that edits the shopper's photo, and the cheap model that pre-checks the photo
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_CHECK_MODEL=gemini-3.1-flash-lite
# auto (Gemini if a key is set, else mock) | gemini | mock
TRYON_MODE=auto
# Reject photos that don't suit the product before paying for image generation
PHOTO_CHECK=true
